# Optional: enables LLM map generation. Configure EITHER a hosted API key or a
# local OpenAI-compatible server (Ollama, LM Studio, llama.cpp — no key needed).
# With neither, the server uses the deterministic procedural generator
# (same schema — the client can't tell).

# Local (e.g. Ollama):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# Hosted (e.g. OpenAI):
#LLM_API_KEY=
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini

PORT=3001
